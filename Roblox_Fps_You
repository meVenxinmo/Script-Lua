local dragging, dragInput, dragStart, startPos

MainFrame.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPos = MainFrame.Position
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                dragging = false
            end
        end)
    end
end)

MainFrame.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
        dragInput = input
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if input == dragInput and dragging then
        local delta = input.Position - dragStart
        MainFrame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
    end
end)

local frameCount = 0
local lastTick = tick()
local currentFPS = 60

RunService.RenderStepped:Connect(function()
    frameCount = frameCount + 1
    local currentTime = tick()
    if currentTime - lastTick >= 1 then
        currentFPS = math.floor(frameCount / (currentTime - lastTick))
        frameCount = 0
        lastTick = currentTime
    end

    local pingValue = 0
    pcall(function()
        pingValue = math.floor(Stats.Network.ServerStatsItem["Data Ping"]:GetValue())
    end)

    local fpsColor = Color3.fromRGB(255, 255, 255)
    if currentFPS >= 120 then
        local hue = (tick() % 5) / 5
        fpsColor = Color3.fromHSV(hue, 1, 1)
    elseif currentFPS >= 70 then
        fpsColor = Color3.fromRGB(170, 0, 255)
    elseif currentFPS >= 50 then
        fpsColor = Color3.fromRGB(0, 255, 0)
    elseif currentFPS >= 20 then
        fpsColor = Color3.fromRGB(255, 120, 120)
    elseif currentFPS >= 10 then
        fpsColor = Color3.fromRGB(255, 0, 0)
    elseif currentFPS >= 5 then
        fpsColor = Color3.fromRGB(150, 0, 0)
    else
        fpsColor = Color3.fromRGB(40, 0, 0)
    end

    local pingColor = Color3.fromRGB(255, 255, 255)
    if pingValue <= 10 then
        local hue = (tick() % 5) / 5
        pingColor = Color3.fromHSV(hue, 1, 1)
    elseif pingValue <= 30 then
        pingColor = Color3.fromRGB(170, 0, 255)
    elseif pingValue <= 50 then
        pingColor = Color3.fromRGB(0, 255, 0)
    elseif pingValue <= 100 then
        pingColor = Color3.fromRGB(255, 165, 0)
    elseif pingValue <= 200 then
        pingColor = Color3.fromRGB(255, 120, 120)
    elseif pingValue <= 500 then
        pingColor = Color3.fromRGB(255, 50, 50)
    else
        pingColor = Color3.fromRGB(150, 0, 0)
    end

    FPSLabel.Text = tostring(currentFPS)
    FPSLabel.TextColor3 = fpsColor

    PingLabel.Text = tostring(pingValue) .. " ms"
    PingLabel.TextColor3 = pingColor
end)
